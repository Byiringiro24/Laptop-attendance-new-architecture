# ============================================================
# EcaAfrica Bridge — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env — it contains secrets unique to each tablet.
# ============================================================

# ── FK623 Device (legacy single-device path) ─────────────────
# Used only if no devices are registered in the Devices page.
# Leave as-is if you manage devices through the Devices page UI.
DEVICE_IP=192.168.1.101
DEVICE_PORT=5005
DEVICE_LICENSE=1261

# ── School Server ─────────────────────────────────────────────
# The EcaAfrica backend API (via WireGuard VPN when on school LAN)
SERVER_API_URL=https://backend.ecareafrica.net/api/v1

# ── Developer Password ────────────────────────────────────────
# Required for protected operations (add/edit/delete devices, users).
# The school server can override this remotely via the Platform Admin.
DEV_PASSWORD=admin1234

# ── WireGuard VPN ─────────────────────────────────────────────
WG_SERVER_ENDPOINT=169.58.124.150:51820
VPN_ALLOWED_IPS=10.0.0.0/16
WG_TUNNEL_NAME=EcareAfrica
WG_DNS=1.1.1.1

# ── Tablet Identity (auto-set by setup wizard) ───────────────
# Leave blank — the WireGuard setup wizard fills these in.
# TABLET_UUID=
# TABLET_NAME=
